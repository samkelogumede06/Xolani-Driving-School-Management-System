# Copy this file to .env and fill in your own values

# ── SERVER ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ── SESSION ──────────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-string

# ── MYSQL DATABASE ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xolani_driving_school

# ── EMAIL (verification + password reset) ───────────────────
# Option 1: SMTP, e.g. a Gmail app password (smtp.gmail.com).
# Option 2: BREVO_API_KEY — use this on hosts that block SMTP ports. It takes priority if set.
# If both are blank in development, emails are printed to the server console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=
MAIL_FROM="Xolani Driving School <no-reply@yourdomain.co.za>"
